# gRPC listen address.
HAPTO_CRYPTO_LISTEN_ADDR=0.0.0.0:50051

# mTLS: hapto-crypto's own server cert/key, and the CA used to verify
# client certs. Every connection must present a client cert signed by this
# CA — there's no plaintext or server-auth-only fallback. Generate all of
# it (both services' certs plus the shared CA) with: ./scripts/gen-certs.sh
# Paths are relative to services/hapto-crypto, which is where `cargo run`
# is normally run from.
HAPTO_CRYPTO_TLS_CERT=../../certs/hapto-crypto.crt
HAPTO_CRYPTO_TLS_KEY=../../certs/hapto-crypto.key
HAPTO_CRYPTO_TLS_CA=../../certs/ca.crt

LOG_LEVEL=info
