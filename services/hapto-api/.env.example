# Postgres. Inside docker compose, host is the service name (postgres);
# for local `go run` outside containers, use localhost.
DATABASE_URL=postgres://hapto:hapto@localhost:5432/hapto?sslmode=disable

# Redis, same host rule as above.
REDIS_URL=redis://localhost:6379/0

# hapto-crypto gRPC address.
HAPTO_CRYPTO_ADDR=localhost:50051

# HTTP port hapto-api listens on.
PORT=8080

# Argon2id pepper, separate from the per-password salt Argon2 generates itself.
# Generate with: openssl rand -base64 32
AUTH_PASSWORD_PEPPER=

# Symmetric key used to encrypt TOTP secrets at rest (AES-256-GCM).
# Generate with: openssl rand -base64 32
AUTH_TOTP_ENCRYPTION_KEY=

# Signing key for session tokens if using signed opaque tokens rather than
# pure random IDs. Generate with: openssl rand -base64 32
SESSION_SIGNING_KEY=

# Session TTL in seconds. Sliding expiry on use, hard cap regardless.
SESSION_IDLE_TTL_SECONDS=1800
SESSION_MAX_TTL_SECONDS=604800

LOG_LEVEL=info
